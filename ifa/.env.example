# --- Obligatoire ---------------------------------------------------------
NODE_ENV=production
PORT=8787
# URL publique de l'appli (liens dans les e-mails, notifications)
PUBLIC_URL=https://frequence.example.fr
# PostgreSQL 14+ (Neon, Supabase, Scaleway, Railway… ou auto-hébergé)
DATABASE_URL=postgres://user:motdepasse@hote:5432/frequence
# Dossier des fichiers envoyés : DOIT être sur un volume persistant
UPLOAD_DIR=/data/uploads

# --- Règles d'âge (voir docs/04-securite-mineurs.md) ----------------------
MIN_AGE=12
PARENTAL_CONSENT_AGE=15
TERMS_VERSION=2026-10

# --- Notifications push web (gratuit) : `npm run vapid` --------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.fr

# --- E-mails (accord parental) : SMTP de n'importe quel fournisseur --------
# ex. smtps://user:pass@smtp.brevo.com:465  (Brevo, Mailjet, Scaleway TEM, OVH…)
SMTP_URL=
MAIL_FROM=Fréquence <no-reply@example.fr>

# --- Intégrations facultatives (API officielles uniquement) ----------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
INSTAGRAM_ACCESS_TOKEN=
