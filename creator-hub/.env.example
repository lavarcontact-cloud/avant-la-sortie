# ─── Accès privé (obligatoire) ──────────────────────────────────────────────
# Mot de passe de l'espace /hub. Choisissez-le long et unique.
ADMIN_PASSWORD=
# Secret de signature des sessions, 32 caractères minimum.
# Générer : openssl rand -hex 32
SESSION_SECRET=

# ─── Base de données ────────────────────────────────────────────────────────
# Production : chaîne de connexion PostgreSQL Supabase (Project Settings → Database
# → Connection string → "Transaction pooler", port 6543). Les migrations de
# migrations/ s'appliquent automatiquement à la première connexion.
# Vide en local : base PGlite embarquée, persistée dans .data/pglite.
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# ─── Bilans planifiés matin / midi / soir ───────────────────────────────────
# Secret attendu par GET /api/cron/reports (en-tête Authorization: Bearer …).
CRON_SECRET=

# ─── Notifications push (facultatif) ────────────────────────────────────────
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# ex. mailto:votre-adresse-pro
VAPID_SUBJECT=
