# VOXA — environment variables
# Leave everything empty/commented to run fully in DEMO mode (zero-config, no external calls).

# --- Translation ---
# API key for an OpenAI-compatible chat completion endpoint used for real, high-quality,
# context- and slang-aware translation. Get one at https://platform.openai.com/api-keys
# (or any compatible provider: Azure OpenAI, OpenRouter, Groq, etc).
# VITE_TRANSLATION_API_KEY=

# Base URL of the OpenAI-compatible chat completions endpoint.
# Defaults to https://api.openai.com/v1/chat/completions when unset.
# VITE_TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions

# Model name to use for translation calls.
# VITE_TRANSLATION_MODEL=gpt-4o-mini

# --- Speech-to-text ---
# VOXA uses the browser's built-in Web Speech API (SpeechRecognition) for STT whenever the
# browser supports it — no key needed. This var is reserved for a future cloud STT provider
# (e.g. Whisper API) that would be used as a higher-quality fallback / non-Chromium browser path.
# VITE_STT_API_KEY=

# --- Text-to-speech ---
# "browser" (default) uses window.speechSynthesis, always available, zero config.
# Set to "cloud" to signal the app to prefer a higher quality cloud voice provider once one
# is wired into providers/VoiceProvider (e.g. ElevenLabs, Azure TTS) via VITE_TTS_API_KEY.
# VITE_TTS_PROVIDER=browser
# VITE_TTS_API_KEY=

# --- Misc ---
# Number of past turns kept as context for the translation engine (pronoun resolution, etc).
# VITE_CONTEXT_WINDOW=6
