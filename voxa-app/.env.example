# LOBA — environment variables
#
# Leave every server-side var below unset to run fully in DEMO mode
# (zero-config, no external calls, nothing leaves the device). Setting the
# server-side translation vars in your Vercel project (or a local .env for
# `vercel dev`) turns on LIVE, AI-backed translation.
#
# IMPORTANT: variables WITHOUT the VITE_ prefix are server-only — Vite never
# bundles them into client JS, so they are safe to hold secrets. Variables
# WITH the VITE_ prefix ARE bundled into the client JS and are visible to
# anyone who opens devtools — never put a secret in a VITE_ var.

# --- Translation (server-side only) ---
# Used exclusively by the serverless function at api/translate.ts, called
# from the browser via a same-origin fetch to /api/translate — the browser
# never sees this key. Calls an OpenAI-compatible chat completions endpoint.
#
# name: TRANSLATION_API_KEY
# purpose: auth for the translation LLM call
# side: SERVER-SIDE ONLY — set in Vercel project settings, never exposed to the browser
# required: yes, for LIVE translation (omit entirely to stay in DEMO mode)
# provider: OpenAI-compatible chat completions API (OpenAI, Azure OpenAI, OpenRouter, Groq, etc.)
# TRANSLATION_API_KEY=

# name: TRANSLATION_API_URL
# purpose: base URL of the OpenAI-compatible chat completions endpoint
# side: SERVER-SIDE ONLY — set in Vercel project settings, never exposed to the browser
# required: no (defaults to https://api.openai.com/v1/chat/completions)
# provider: same as TRANSLATION_API_KEY
# TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions

# name: TRANSLATION_MODEL
# purpose: model name for translation calls
# side: SERVER-SIDE ONLY — set in Vercel project settings, never exposed to the browser
# required: no (defaults to gpt-4o-mini)
# provider: same as TRANSLATION_API_KEY
# TRANSLATION_MODEL=gpt-4o-mini

# --- Speech-to-text (client-side, reserved) ---
# name: VITE_STT_API_KEY
# purpose: placeholder for a future cloud STT provider (e.g. Whisper) as a
#   higher-quality / non-Chromium fallback. Not wired into any provider yet.
# side: client-side (VITE_ prefix — would be visible in the browser bundle;
#   do NOT use this pattern for a real secret — route it through a
#   serverless function instead, the same way translation is done)
# required: no
# provider: none yet (placeholder)
# VITE_STT_API_KEY=

# --- Text-to-speech (client-side, reserved) ---
# name: VITE_TTS_PROVIDER
# purpose: "browser" (default) uses window.speechSynthesis, always available,
#   zero config. "cloud" would signal a future higher-quality cloud voice
#   provider once wired into providers/VoiceProvider.
# side: client-side
# required: no (defaults to "browser")
# provider: browser speechSynthesis, or a future cloud TTS provider
# VITE_TTS_PROVIDER=browser

# name: VITE_TTS_API_KEY
# purpose: placeholder for a future cloud TTS provider (e.g. ElevenLabs, Azure
#   TTS). Not wired into any provider yet — same warning as VITE_STT_API_KEY
#   applies if this is ever implemented: route real keys through a
#   serverless function, never a VITE_ var.
# side: client-side
# required: no
# provider: none yet (placeholder)
# VITE_TTS_API_KEY=

# --- Misc (client-side) ---
# name: VITE_CONTEXT_WINDOW
# purpose: number of past conversation turns kept as context for the
#   translation engine (pronoun/reference resolution)
# side: client-side (not a secret, safe to bundle)
# required: no (defaults to 6)
# provider: n/a
# VITE_CONTEXT_WINDOW=6
