# Copier en .env.local (développement) ou saisir dans Vercel > Settings > Environment Variables.
# Aucune de ces valeurs ne doit être commitée.

# URL publique du site (liens de paiement, sitemap, métadonnées).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Supabase, Neon...). Vide en développement = base embarquée PGlite dans .data/.
# Avec Supabase, utiliser l'URL du pooler (port 6543) en production.
DATABASE_URL=

# Espace admin : générer les deux valeurs avec  npm run admin:hash -- "votre mot de passe"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Stripe : clés de TEST uniquement (sk_test_..., whsec_...) jusqu'à validation explicite.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Garde-fou : une clé sk_live_ est refusée tant que cette variable ne vaut pas "true".
STRIPE_LIVE_APPROVED=

# Notification e-mail des nouvelles demandes (facultatif, via Resend).
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Purge planifiée des données expirées (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Sel pour l'empreinte des IP (limitation de débit). Par défaut : SESSION_SECRET.
IP_HASH_SALT=

# Indexation par les moteurs : laisser vide tant que contenus et droits ne sont pas validés.
SITE_INDEXABLE=
